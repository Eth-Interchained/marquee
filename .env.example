# Copy to .env and fill in. Never commit the filled-in file.

# Credential for api.AiAssist.net. Read only by the API server; it is never
# exposed to a renderer process or sent to the browser.
# The older spelling AIAssIST_API_KEY still works but warns on first use.
AIASSIST_API_KEY=

# Append-only ledger location. Back this directory up — it is the app's memory.
# NEDB_DATA_DIR=./.data/marquee

# Loopback address of the desktop shell's publisher endpoint. The shell sets
# this itself. Leave it unset anywhere else: unset means publishing is
# disabled, which is the correct behaviour outside the shell.
# MARQUEE_SESSION_BRIDGE_URL=

# "single" (default) scopes every document to the personal tenant.
# "multi" requires an auth layer to supply the tenant, and returns 401 without one.
# MARQUEE_TENANCY_MODE=single
