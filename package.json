{
  "name": "marquee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "marquee — the whole broadcast studio in a browser tab. Screen + cam + social widgets + go-live, with NEDB as the provenance spine.",
  "license": "BUSL-1.1",
  "scripts": {
    "dev": "portal dev",
    "build": "portal build",
    "preview": "portal preview",
